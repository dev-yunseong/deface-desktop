{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deface Desktop",
  "version": "0.1.0",
  "identifier": "dev.yunseong.deface",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Deface Desktop",
      "width": 820,
      "height": 760,
      "minWidth": 520,
      "minHeight": 620
    }],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; style-src 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5QTJGNDRDQThGMzFGMTcKUldRWEgvT29UUFNpeWJyVkJRbUl5aFZQckxyOERnVnp2RTJETnVXY1V6UElyWVN1NXRCek5pM0UK",
      "endpoints": ["https://github.com/dev-yunseong/deface-desktop/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["bin/deface-engine", "bin/deface-ffmpeg"],
    "resources": {
      "../../LICENSE": "deface-LICENSE.txt",
      "bin/FFmpeg-LICENSE.txt": "FFmpeg-LICENSE.txt",
      "bin/engine-notices.txt": "engine-notices.txt"
    }
  }
}
